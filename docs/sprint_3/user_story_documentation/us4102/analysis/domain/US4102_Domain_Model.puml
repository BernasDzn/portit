@startuml US4102_Domain_Model
title US4102 - Automatic Generation of Operation Plans - Domain Model

package "Operation Planning Domain" {
    entity "Vessel Visit Notification" as VVN {
        * id: string
        * vesselName: string
        * plannedArrival: Date
        * plannedDock: string
        * status: VVNStatus
    }

    entity "Operation Plan" as OpPlan {
        * id: string
        * relatedVVN: string
        * dock: string
        * date: Date
        * operationSchedule: Operation[]
        * metadata: OperationPlanMetadata
    }

    entity "Operation" as Op {
        * id: string
        * operationType: string
        * startTime: Date
        * endTime: Date
        * resources: Resource[]
        * payload: Payload
    }

    entity "Resource" as Res {
        * id: string
        * name: string
        * type: ResourceType
        * startTime: Date
        * endTime: Date
    }

    entity "Scheduling Algorithm" as Algo {
        * id: string
        * name: string
        * description: string
        * parameters: object
    }

    entity "Container" as Cont {
        * containerCode: string
        * weight: number
        * destination: string
    }

    entity "Operation Plan Metadata" as Meta {
        * createdBy: string
        * createdAt: Date
        * algorithmUsed: string
    }
}

VVN "1" --o "0..*" OpPlan : relates to
OpPlan "1" --o "1..*" Op : schedules
Op "1" --o "1..*" Res : uses
Op "1" --o "1" Cont : carries
OpPlan "1" --o "1" Algo : generated by
OpPlan "1" --o "1" Meta : has

@enduml
