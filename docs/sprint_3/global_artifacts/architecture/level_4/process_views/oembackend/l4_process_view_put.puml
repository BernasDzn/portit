@startuml l4_process_view_put
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor User as Actor
participant "(Frontend)\nX View" as View <<presentation>>
participant "(Frontend)\nX Service" as UiXService <<service>>
participant "(Frontend)\nHTTPService" as UiHttp <<service>>
participant "API" as API <<application>>
participant "(OEMBackend)\nXController" as Controller <<controller>>
participant "(OEMBackend)\nXService" as Service <<service>>
participant "(OEMBackend)\nXRepository" as Repository <<repository>>
participant "(OEMBackend)\nX Mapper" as Mapper <<mapper>>
participant "(OEMBackend)\nX" as Domain <<domain>>
participant "(OEMBackend)\nXDto" as Dto <<data transfer>>
participant "(OEMBackend)\nODM Context" as Context <<context>>
database MongoDB

title OEMBackend - Update process view for generic "X" entity (PUT/PATCH)

Actor --> View: Submit updated data
activate View

    View --> UiXService: updateX(id, data)
    activate UiXService

        UiXService --> UiHttp: PUT /api/x/{id} {data}
        activate UiHttp

            UiHttp --> API: HTTP PUT /api/x/{id}
            activate API

                API --> Controller: route -> XController.updateX(id, data)
                activate Controller

                    Controller --> Service: update(id, data)
                    activate Service

                        Service --> Repository: getById(id)
                        activate Repository
                            Repository --> Context: findOne({ id })
                            activate Context
                                Context --> MongoDB: findOne
                                activate MongoDB
                                    MongoDB --> Context: document
                                deactivate MongoDB
                                Context --> Repository: document
                            deactivate Context

                            Repository --> Mapper: fromSchema(document)
                            activate Mapper
                                Mapper --> Domain: new X(data)
                                activate Domain
                                    Domain --> Mapper: X instance
                                deactivate Domain
                                Mapper --> Repository: X instance
                            deactivate Mapper

                            Repository --> Service: X instance
                        deactivate Repository

alt entity found
                        Service --> Domain: X.update(data)
                        activate Domain
alt valid data
                            Domain --> Service: updated X instance
else invalid data
                            Domain --> Service: Validation Error
                        deactivate Domain
end

                        Service --> Repository: save(updatedX)
                        activate Repository
                            Repository --> Mapper: toPersistence(updatedX)
                            activate Mapper
                                Mapper --> Repository: persistenceDoc
                            deactivate Mapper

                            Repository --> Context: updateOne({ id }, persistenceDoc)
                            activate Context
                                Context --> MongoDB: updateOne
                                activate MongoDB
                                    MongoDB --> Context: updatedDocument
                                deactivate MongoDB
                                Context --> Repository: updatedDocument
                            deactivate Context

                            Repository --> Mapper: fromSchema(updatedDocument)
                            activate Mapper
                                Mapper --> Domain: new X(data)
                                activate Domain
                                    Domain --> Mapper: updated X instance
                                deactivate Domain
                                Mapper --> Repository: updated X instance
                            deactivate Mapper

                            Repository --> Service: updated X instance
                        deactivate Repository

                        Service --> Mapper: toDto(updated X instance)
                        activate Mapper
                            Mapper --> Dto: updated X instance
                            activate Dto
                                Dto --> Mapper: X DTO
                            deactivate Dto
                            Mapper --> Service: X DTO
                        deactivate Mapper

                        Service --> Controller: X DTO
else entity not found
                        Service --> Controller: Not Found Error
end
                    deactivate Service

                    Controller --> API: 200 OK + body
                deactivate Controller

            API --> UiHttp: HTTP Response 200
            deactivate API

        UiHttp --> UiXService: HTTP response (200)
        deactivate UiHttp

        UiXService --> View: updated X data
    deactivate UiXService

    View --> Actor: Show updated X details
deactivate View

@enduml
