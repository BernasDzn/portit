@startuml l4_process_view_get_filter
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor User as Actor
participant "(Frontend)\nX View" as View <<presentation>>
participant "(Frontend)\nX Service" as UiXService <<service>>
participant "(Frontend)\nHTTPService" as UiHttp <<service>>
participant "API" as API <<application>>
participant "(OEMBackend)\nXController" as Controller <<controller>>
participant "(OEMBackend)\nXService" as Service <<service>>
participant "(OEMBackend)\nXRepository" as Repository <<repository>>
participant "(OEMBackend)\nX Mapper" as Mapper <<mapper>>
participant "(OEMBackend)\nX" as Domain <<domain>>
participant "(OEMBackend)\nXDto" as Dto <<data transfer>>
participant "(OEMBackend)\nODM Context" as Context <<context>>
database MongoDB

title OEMBackend - Read process view for generic "X" entity with filters (GET paginated)

Actor --> View: Open X list page / apply filters
activate View

    View --> UiXService: getPaged(filters)
    activate UiXService

        UiXService --> UiHttp: GET /api/x?filter1=value1&pageNumber=1&pageSize=10
        activate UiHttp

            UiHttp --> API: HTTP GET /api/x?filters
            activate API

                API --> Controller: route -> XController.getPaged(filters)
                activate Controller

                    Controller --> Service: getPaged(filter)
                    activate Service

                        Service --> Repository: getPaged(filter)
                        activate Repository
                            Repository --> Context: find(filterQuery).skip().limit()
                            activate Context
                                Context --> MongoDB: find with filters, skip, limit
                                activate MongoDB
                                    MongoDB --> Context: documents[]
                                deactivate MongoDB
                                Context --> Repository: documents[]
                            deactivate Context

                            loop for each document
                                Repository --> Mapper: fromSchema(document)
                                activate Mapper
                                    Mapper --> Domain: new X(data)
                                    activate Domain
                                        Domain --> Mapper: X instance
                                    deactivate Domain
                                    Mapper --> Repository: X instance
                                deactivate Mapper
                            end

                            Repository --> Context: countDocuments(filterQuery)
                            activate Context
                                Context --> MongoDB: countDocuments
                                activate MongoDB
                                    MongoDB --> Context: total count
                                deactivate MongoDB
                                Context --> Repository: total count
                            deactivate Context

                            Repository --> Service: X instances[] + total count
                        deactivate Repository

                        loop for each X instance
                            Service --> Mapper: toDto(X instance)
                            activate Mapper
                                Mapper --> Dto: X instance
                                activate Dto
                                    Dto --> Mapper: X DTO
                                deactivate Dto
                                Mapper --> Service: X DTO
                            deactivate Mapper
                        end

                        Service --> Controller: Pageable<X DTO>
                    deactivate Service

                    Controller --> API: 200 OK + body
                deactivate Controller

            API --> UiHttp: HTTP Response (200)
            deactivate API

        UiHttp --> UiXService: HTTP response (200)
        deactivate UiHttp

        UiXService --> View: Pageable data (items[], totalItems, page info)
    deactivate UiXService

    View --> Actor: Render filtered list with pagination
deactivate View

@enduml
