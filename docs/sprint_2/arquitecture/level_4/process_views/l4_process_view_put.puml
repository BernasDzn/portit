@startuml sequence_diagram_put
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor User as Actor
participant "UI Pages" as UI <<presentation>>
participant "UI XptoDto" as UiDto <<dto>>
participant "UI XptoService" as UiService <<service>>
participant "UI XptoModel" as UiModel <<model>>
participant API as API <<application>>
participant XptoController as Controller <<controller>>
participant XptoService as Service <<service>>
participant XptoRepository as Repository <<repository>>
participant XptoContext as Context <<context>>
participant XptoDto as Dto <<dto>>
participant XptoModel as Model <<entity>>
database Database

title Update Xpto

Actor -> UI: Fill update form
Actor --> UI: Update Xpto
activate UI

    UI --> UiDto: new XptoDto(formData)
    activate UiDto
        UiDto --> UI: dtoInstance
    deactivate UiDto

    UI --> UiService: updateXpto(dtoInstance)
    activate UiService

        UiService --> UiModel: new XptoModel(dtoInstance)
        activate UiModel
            UiModel --> UiModel: Validate
            UiModel --> UiService: xptoModel
        deactivate UiModel

        UiService --> API: HTTP PUT /api/xpto/{id}
        activate API

            alt Check authorization diagram
                API --> Controller: route
            end
            activate Controller

                Controller --> Service: Request update
                activate Service

                    Service --> Repository: GetXpto(id)
                    activate Repository
                    
                        Repository --> Context: Get(id)
                        activate Context
                            Context --> Database: SELECT
                            Context --> Repository: xptoInstance?
                        deactivate Context

                        Repository --> Service: xptoInstance?
                    deactivate Repository

                    group if not xptoInstance exists
                        Service --> Controller: EntityNotFoundException 
                        activate Controller
                            Controller --> API: NotFound()
                            activate API
                                API --> UiService: HTTP Response
                            deactivate API
                            UiService --> UI: Error
                        deactivate Controller
                    end

                    Service --> Repository: Update(data)
                    activate Repository
                    
                        Repository --> Model: Update(data)
                        activate Model
                            Model --> Repository: updatedXpto
                        deactivate Model
                        
                        Repository --> Context: Save(updatedXpto)
                        activate Context
                            Context --> Database: UPDATE
                            Context --> Repository: status
                        deactivate Context

                        Repository --> Service: status
                    deactivate Repository

                    Service --> Controller: status
                deactivate Service

                Controller --> API: NoContent()
            deactivate Controller

            API --> UiService: HTTP Reponse
        deactivate API

        UiService --> UI: update success
    deactivate UiService

UI --> Actor: Success
deactivate UI

@enduml
