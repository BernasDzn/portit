@startuml sequence_diagram_delete
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor User as Actor
participant "UI Pages" as UI <<presentation>>
participant "UI XptoDto" as UiDto <<dto>>
participant "UI XptoService" as UiService <<service>>
participant "UI XptoModel" as UiModel <<model>>
participant API as API <<application>>
participant XptoController as Controller <<controller>>
participant XptoService as Service <<service>>
participant XptoRepository as Repository <<repository>>
participant XptoContext as Context <<context>>
participant XptoDto as Dto <<dto>>
participant XptoModel as Model <<entity>>
database Database

title Delete Xpto

Actor --> UI: Types information
Actor --> UI: Submits form
activate UI

    UI --> UiDto: new XptoDto
    activate UiDto
        UiDto --> UI: xptoDto
    deactivate UiDto

    UI --> UiService: deleteXpto()
    activate UiService
        UiService --> UiModel: new XptoModel(xptoDto)
        UiModel --> UiModel: Validate
        UiModel --> UiService: xptoInstance

        UiService --> API: HTTP DELETE /api/xpto/{id}

        activate API

            alt Check authorization diagram
                API --> Controller: route
            end
            activate Controller

                Controller --> Service: Request deletion
                activate Service

                    Service --> Repository: GetXpto(id)
                    activate Repository
                    
                        Repository --> Context: Get(id)

                        activate Context
                            Context --> Database: SELECT
                            Context --> Repository: xptoInstance?
                        deactivate Context

                        Repository --> Service: xptoInstance?
                    deactivate Repository

                    group if not xptoInstance exists
                        Service --> Controller: EntityNotFoundException 
                        activate Controller
                            Controller --> API: NotFound()
                            activate API
                                API --> UiService: HTTP Response
                                UiService --> UI: deletion error

                            deactivate API
                            UI --> Actor: Error
                        deactivate Controller
                    end

                    Service --> Repository: Delete(xptoInstance)
                    activate Repository
                    
                        Repository --> Context: Delete(xptoInstance)

                        activate Context
                            Context --> Database: DELETE
                            Context --> Repository: status
                        deactivate Context

                        Repository --> Service: status
                    deactivate Repository

                    Service --> Controller: status
                deactivate Service

                Controller --> API: NoContent()
            deactivate Controller

            API --> UiService: HTTP Reponse
        deactivate API
        UiService --> UI: deletion success
    deactivate UiService

UI --> Actor: Success
deactivate UI
            
@enduml