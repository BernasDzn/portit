@startuml auth_flow_v2
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor User as User
participant "U I" as FE <<presentation>>
participant "Google OAuth" as Google <<oauth>>

' Backend pieces
participant "AuthController" as AuthController <<controller>>
participant "GoogleAuthProvider" as GoogleProvider <<service>>
participant "SystemUserService" as UserService <<service>>
participant "SystemUserRepository" as UserRepo <<repository>>
participant "UserManager" as Identity <<service>>
participant "JwtTokenService" as JwtService <<service>>
participant "Cookie Store" as Cookie <<storage>>

database "ApiContext (DB)" as DB <<database>>

title Authentication flow

User -> FE: Click "Login with Google"
FE -> Google: Request Google OAuth ID token
Google --> FE: Return ID Token

FE -> AuthController: POST /auth/login/google { token }
activate AuthController

    AuthController -> GoogleProvider: ValidateTokenAsync(token)
    activate GoogleProvider
        GoogleProvider -> Google: (validate token with Google's JWKS / endpoint)
        Google --> GoogleProvider: Token payload (sub, email, name, picture)
        GoogleProvider --> AuthController: AuthProviderResult { IsValid, ExternalId(sub), Email, Name, Picture }
    deactivate GoogleProvider

    alt token invalid
        AuthController --> FE: 401 Unauthorized
        deactivate AuthController
    end

    AuthController -> UserService: GetBySub(ExternalId)
    activate UserService

        UserService -> UserRepo: GetBySubAsync(sub)
        activate UserRepo
            UserRepo -> DB : SELECT 
            DB --> UserRepo : SystemUser
            UserRepo --> UserService : SystemUser
        deactivate UserRepo

        alt user not found
            UserService --> AuthController : throws EntityNotFoundException
            deactivate UserService
                AuthController --> FE: 401 Unauthorized
            deactivate AuthController
        else user exists
            UserService -> Identity: GetRolesAsync(SystemUser)
            activate Identity
                Identity --> UserService: roles
            deactivate Identity

            UserService --> AuthController: systemUserDto
        end
    deactivate UserService

    AuthController -> JwtService: GenerateToken(claims)
    activate JwtService
        JwtService --> AuthController: JWT
    deactivate JwtService

    note right of AuthController
        Set cookie options:
        HttpOnly, Secure, SameSite=Strict,
        Expires = now + Jwt:ExpiresMinutes
    end note

    AuthController -> Cookie: Set-Cookie: AuthToken=<JWT>; HttpOnly; Secure; SameSite=Strict
    AuthController --> FE: token
deactivate AuthController
@enduml
