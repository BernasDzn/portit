@startuml sequence_diagram_delete
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor User as Actor
participant "U I" as UI <<presentation>>
participant API as API <<application>>
participant XptoController as Controller <<controller>>
participant XptoService as Service <<service>>
participant XptoRepository as Repository <<repository>>
participant XptoContext as Context <<context>>
participant XptoDto as Dto <<dto>>
participant XptoModel as Model <<entity>>
database Database

title Delete Xpto

Actor --> UI: Delete Xpto
activate UI

    UI --> API: HTTP DELETE /api/xpto/{id}

    activate API

        API --> Controller: route
        activate Controller

            Controller --> Service: Request deletion
            activate Service

                Service --> Repository: GetXpto(id)
                activate Repository
                
                    Repository --> Context: Get(id)

                    activate Context
                        Context --> Database: SELECT
                        Context --> Repository: xptoInstance?
                    deactivate Context

                    Repository --> Service: xptoInstance?
                deactivate Repository

                group if not xptoInstance exists
                    Service --> Controller: EntityNotFoundException 
                    activate Controller
                        Controller --> API: NotFound()
                        activate API
                            API --> UI: HTTP Response
                        deactivate API
                        UI --> Actor: Error
                    deactivate Controller
                end

                Service --> Repository: Delete(xptoInstance)
                activate Repository
                
                    Repository --> Context: Delete(xptoInstance)

                    activate Context
                        Context --> Database: DELETE
                        Context --> Repository: status
                    deactivate Context

                    Repository --> Service: status
                deactivate Repository

                Service --> Controller: status
            deactivate Service

            Controller --> API: NoContent()
        deactivate Controller

        API --> UI: HTTP Reponse
    deactivate API

UI --> Actor: Success
deactivate UI
            
@enduml