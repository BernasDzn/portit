@startuml processview_n1
Actor "User" as user
Participant "System" as System <<System C4>>
Participant "EFCoreApi" as EFCoreApi <<Container C4>>

user -> System: Request Insertion
activate System
    System --> EFCoreApi: Insert Data
    activate EFCoreApi
    System <-- EFCoreApi: Data Inserted
    deactivate EFCoreApi
    user <-- System: Insertion Confirmed
deactivate System

@enduml